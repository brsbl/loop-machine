{
  "name": "loop-machine",
  "version": "1.0.0",
  "description": "A web-based loop machine/drum sequencer",
  "main": "script.js",
  "type": "module",
  "scripts": {
    "dev": "npx serve public -l 3000",
    "start": "npm run dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.{json,md}\"",
    "check": "npm run format:check && npm run lint && npm test",
    "clean": "rm -rf coverage node_modules",
    "prepare": "husky"
  },
  "keywords": [
    "drum-machine",
    "sequencer",
    "web-audio"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/types": "^7.28.1",
    "babel-jest": "^30.0.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.10.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.0.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,json,md}": "prettier --write"
  }
}
