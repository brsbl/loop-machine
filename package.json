{
  "name": "loop-machine",
  "version": "1.0.0",
  "description": "A web-based loop machine/drum sequencer",
  "main": "script.js",
  "type": "module",
  "scripts": {
    "dev": "npx serve public -l 3000",
    "start": "npm run dev",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests --ext .js",
    "lint:fix": "eslint src tests --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.{json,md}\"",
    "check": "npm run format:check && npm run lint && npm test",
    "clean": "rm -rf coverage node_modules"
  },
  "keywords": [
    "drum-machine",
    "sequencer",
    "web-audio"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-jest": "^27.6.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,css,json,md}": "prettier --write"
  },
  "dependencies": {
    "2": "^3.0.0"
  }
}
